{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdin.resume();let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const f=JSON.parse(d).tool_input?.file_path;if(f){require('child_process').spawnSync('npx',['prettier','--write',f],{stdio:'inherit',shell:true})}})\""
          }
        ]
      }
    ]
  }
}